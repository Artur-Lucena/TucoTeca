{
  "name": "tucoteca-electron",
  "version": "2.0.0",
  "private": true,
  "description": "TucoTeca — hub local de jogos, músicas e vídeos (interface Electron)",
  "author": "Tuco",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "selftest": "electron-vite build && electron . --selftest",
    "dist": "electron-vite build && electron-builder --win --config electron-builder.config.cjs",
    "dist:mac": "electron-vite build && electron-builder --mac --config electron-builder.config.cjs"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "electron": "^44.11.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "preact": "^11.2.0"
  }
}
