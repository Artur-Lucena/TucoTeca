# Normaliza fim de linha entre Windows e Linux (código sempre LF)
* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.command text eol=lf
*.iss text eol=lf
*.run text eol=lf
*.qml text eol=lf
qmldir text eol=lf
*.vbs text eol=crlf
*.bat text eol=crlf
.gitignore text eol=lf
LICENSE text eol=lf
