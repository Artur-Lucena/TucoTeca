# Normaliza fim de linha entre Windows e Linux (código sempre LF)
* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.command text eol=lf
*.bat text eol=crlf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf
*.ico binary
*.png binary
