{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": ["dados/**", "programa/**", "dist/**", ".provas/**"]
  },
  "permissions": [
    { "action": "read", "resource": "dados", "effect": "deny" },
    { "action": "read", "resource": "dados/*", "effect": "deny" },
    { "action": "read", "resource": "*/dados", "effect": "deny" },
    { "action": "read", "resource": "*/dados/*", "effect": "deny" },
    { "action": "read", "resource": "programa", "effect": "deny" },
    { "action": "read", "resource": "programa/*", "effect": "deny" },
    { "action": "read", "resource": "*/programa", "effect": "deny" },
    { "action": "read", "resource": "*/programa/*", "effect": "deny" },
    { "action": "read", "resource": "*biblioteca-antes-caminhos.db", "effect": "deny" }
  ]
}
